# Copy to .env and fill in values. Used by docker compose in this directory.
# Do not commit .env.
NUGET_AUTH_TOKEN=
SA_PASSWORD=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase_service_account.json
# Six Labors ImageSharp 4.x build-time license — paste the FULL contents of sixlabors.lic
# (Id=...;Kind=...;ExpiryDateUtc=...;Key=...), not only a customer/portal id.
SIXLABORS_LICENSE_KEY=
